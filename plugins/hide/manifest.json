{
  "id": "hide",
  "name": "Hide Button",
  "version": "1.1.0",
  "apiVersion": "2",
  "description": "A corner button that hides the app. H minimises.",
  "permissions": [
    "window",
    "board:write"
  ],
  "main": "main.ts",
  "styles": [
    "style.css"
  ],
  "contributions": {
    "overlays": [
      {
        "id": "corner-button",
        "title": "Corner button"
      }
    ],
    "settingsSections": [
      {
        "id": "corner",
        "title": "Hide"
      }
    ],
    "shortcuts": [
      {
        "key": "h",
        "title": "Hide the board (minimise)"
      }
    ]
  }
}
